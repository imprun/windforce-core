{
  "app": "runtime_secrets",
  "entrypoint": "main.ts",
  "scriptLang": "typescript",
  "actions": {
    "deliver": {
      "inputSchema": "deliver.input.schema.json",
      "outputSchema": "deliver.output.schema.json",
      "operatorSettingsSchema": "deliver.settings.schema.json",
      "runtimeAccess": {
        "variables": [
          {"scope": "app", "path": "secrets/partner-token"}
        ]
      }
    },
    "refresh": {
      "runtimeAccess": {
        "variables": [
          {"scope": "app", "path": "sessions/playwright"}
        ],
        "writeVariables": [
          {"scope": "app", "path": "sessions/playwright", "storage": "secret"}
        ],
        "writeResources": [
          {"scope": "app", "path": "sessions/meta"}
        ]
      }
    },
    "consume": {
      "runtimeAccess": {
        "variables": [
          {"scope": "app", "path": "sessions/playwright"}
        ],
        "resources": [
          {"scope": "app", "path": "sessions/meta"}
        ]
      }
    }
  }
}
