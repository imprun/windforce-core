{
  "openapi": "3.1.0",
  "info": {
    "title": "Windforce Invocation API",
    "version": "v1",
    "description": "Canonical system-to-system API for admitting and observing Runs. Authentication establishes the principal; callers cannot assert identity or execution environment fields."
  },
  "servers": [
    {
      "url": "https://windforce.example"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "getInvocationOpenAPI",
        "summary": "Get the Invocation API specification",
        "security": [],
        "responses": {
          "200": {
            "description": "Invocation OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/{workspace}/runs": {
      "post": {
        "operationId": "createRun",
        "summary": "Admit a Run",
        "parameters": [
          {
            "$ref": "#/components/parameters/Workspace"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/AdmissionProbe"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRunRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An authenticated admission probe completed or an idempotent retry replayed the existing Run.",
            "headers": {
              "Location": { "$ref": "#/components/headers/RunLocation" },
              "X-WF-Run-Id": { "$ref": "#/components/headers/RunID" },
              "X-WF-Run-State": { "$ref": "#/components/headers/RunState" },
              "X-WF-Idempotency-Reused": { "$ref": "#/components/headers/IdempotencyReused" },
              "X-WF-Admission-Probed": { "$ref": "#/components/headers/AdmissionProbed" },
              "X-WF-Admission-Id": { "$ref": "#/components/headers/AdmissionID" },
              "X-WF-Admission-Fingerprint": { "$ref": "#/components/headers/AdmissionFingerprint" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/Run" },
                    { "$ref": "#/components/schemas/AdmissionProbe" }
                  ]
                }
              }
            }
          },
          "201": {
            "description": "Run admitted.",
            "headers": {
              "Location": { "$ref": "#/components/headers/RunLocation" },
              "X-WF-Run-Id": { "$ref": "#/components/headers/RunID" },
              "X-WF-Run-State": { "$ref": "#/components/headers/RunState" },
              "X-WF-Idempotency-Reused": { "$ref": "#/components/headers/IdempotencyReused" },
              "X-WF-Admission-Id": { "$ref": "#/components/headers/AdmissionID" },
              "X-WF-Admission-Fingerprint": { "$ref": "#/components/headers/AdmissionFingerprint" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/v1/workspaces/{workspace}/runs/wait": {
      "post": {
        "operationId": "createRunAndWait",
        "summary": "Admit a Run and wait for a terminal result",
        "parameters": [
          {
            "$ref": "#/components/parameters/Workspace"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/AdmissionProbe"
          },
          {
            "name": "timeout",
            "in": "query",
            "required": false,
            "description": "Go duration bounded by the server maximum.",
            "schema": {
              "type": "string",
              "example": "30s"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRunRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated admission probe or terminal Run result.",
            "headers": {
              "Location": { "$ref": "#/components/headers/RunLocation" },
              "X-WF-Run-Id": { "$ref": "#/components/headers/RunID" },
              "X-WF-Run-State": { "$ref": "#/components/headers/RunState" },
              "X-WF-Idempotency-Reused": { "$ref": "#/components/headers/IdempotencyReused" },
              "X-WF-Admission-Probed": { "$ref": "#/components/headers/AdmissionProbed" },
              "X-WF-Admission-Id": { "$ref": "#/components/headers/AdmissionID" },
              "X-WF-Admission-Fingerprint": { "$ref": "#/components/headers/AdmissionFingerprint" }
            },
            "content": {
              "application/json": {
                "schema": true
              }
            }
          },
          "202": {
            "description": "The Run is still pending when the wait timeout expires.",
            "headers": {
              "Location": { "$ref": "#/components/headers/RunLocation" },
              "X-WF-Run-Id": { "$ref": "#/components/headers/RunID" },
              "X-WF-Run-State": { "$ref": "#/components/headers/RunState" },
              "X-WF-Idempotency-Reused": { "$ref": "#/components/headers/IdempotencyReused" },
              "X-WF-Admission-Id": { "$ref": "#/components/headers/AdmissionID" },
              "X-WF-Admission-Fingerprint": { "$ref": "#/components/headers/AdmissionFingerprint" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/v1/workspaces/{workspace}/runs/{run_id}": {
      "get": {
        "operationId": "getRun",
        "summary": "Get Run status",
        "parameters": [
          {
            "$ref": "#/components/parameters/Workspace"
          },
          {
            "$ref": "#/components/parameters/RunID"
          }
        ],
        "responses": {
          "200": {
            "description": "Run status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/workspaces/{workspace}/runs/{run_id}/result": {
      "get": {
        "operationId": "getRunResult",
        "summary": "Get Run result",
        "parameters": [
          {
            "$ref": "#/components/parameters/Workspace"
          },
          {
            "$ref": "#/components/parameters/RunID"
          }
        ],
        "responses": {
          "200": {
            "description": "Terminal Run result.",
            "content": {
              "application/json": {
                "schema": true
              }
            }
          },
          "202": {
            "description": "The Run is not terminal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/workspaces/{workspace}/runs/{run_id}/cancel": {
      "post": {
        "operationId": "cancelRun",
        "summary": "Cancel a Run",
        "parameters": [
          {
            "$ref": "#/components/parameters/Workspace"
          },
          {
            "$ref": "#/components/parameters/RunID"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelRunRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Run canceled or already terminal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/workspaces/{workspace}/apps/{app}": {
      "get": {
        "operationId": "describeInvocationApp",
        "summary": "Describe the active App release and Actions",
        "parameters": [
          {
            "$ref": "#/components/parameters/Workspace"
          },
          {
            "name": "app",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Active App description.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/App"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Operator, workspace, Client Registry (wfk_), or Service Principal (wfs_) token."
      }
    },
    "parameters": {
      "Workspace": {
        "name": "workspace",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "RunID": {
        "name": "run_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "Scopes retry-safe admission to the authenticated principal. Reusing a key with a different request returns 409.",
        "schema": {
          "type": "string",
          "maxLength": 200
        }
      },
      "AdmissionProbe": {
        "name": "X-WF-Admission-Probe",
        "in": "header",
        "required": false,
        "description": "When true, authenticate and bind the idempotent request without creating a Run. Idempotency-Key is then required.",
        "schema": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "headers": {
      "RunLocation": {
        "description": "Canonical URL of the admitted Run.",
        "schema": {
          "type": "string"
        }
      },
      "RunID": {
        "description": "Caller-visible Run identifier.",
        "schema": {
          "type": "string"
        }
      },
      "RunState": {
        "description": "Run state observed for this response.",
        "schema": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "waiting_human",
            "resuming",
            "succeeded",
            "failed",
            "canceled",
            "expired"
          ]
        }
      },
      "IdempotencyReused": {
        "description": "True when this admission reused the existing Run for the same Idempotency-Key and request.",
        "schema": {
          "type": "boolean"
        }
      },
      "AdmissionProbed": {
        "description": "True only for a non-mutating authenticated admission probe response.",
        "schema": { "type": "boolean" }
      },
      "AdmissionID": {
        "description": "Opaque stable identity for the idempotent admission.",
        "schema": { "type": "string" }
      },
      "AdmissionFingerprint": {
        "description": "Canonical request fingerprint bound by Core; contains no raw request or credential material.",
        "schema": { "type": "string" }
      }
    },
    "schemas": {
      "CreateRunRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "app",
          "action",
          "input"
        ],
        "properties": {
          "app": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "input": true,
          "correlation_id": {
            "type": "string"
          }
        }
      },
      "CancelRunRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      },
      "AdmissionProbe": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "admission_id",
          "request_fingerprint",
          "state",
          "replayed"
        ],
        "properties": {
          "admission_id": { "type": "string" },
          "request_fingerprint": { "type": "string" },
          "state": {
            "type": "string",
            "enum": ["ready", "admitted", "aborted"]
          },
          "run_id": { "type": "string" },
          "replayed": { "type": "boolean" }
        }
      },
      "Run": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "state",
          "app",
          "action",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "waiting_human",
              "resuming",
              "succeeded",
              "failed",
              "canceled",
              "expired"
            ]
          },
          "app": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          },
          "replayed": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "App": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "app",
          "release",
          "actions"
        ],
        "properties": {
          "app": {
            "type": "string"
          },
          "release": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commit",
              "bundle_digest"
            ],
            "properties": {
              "deployment_id": {
                "type": "string"
              },
              "api_version": {
                "type": "string"
              },
              "commit": {
                "type": "string"
              },
              "bundle_digest": {
                "type": "string"
              }
            }
          },
          "actions": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_schema",
                "output_schema"
              ],
              "properties": {
                "input_schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "output_schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "public_interfaces": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "description": "Bounded opaque public interface declarations from the pinned Release. Core does not interpret declaration fields."
                },
                "timeout": {
                  "type": "integer",
                  "format": "int32"
                },
                "runs_on": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid authentication.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The principal lacks the required scope, ownership, or target permission.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Workspace, App, Action, or Run not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Idempotency or admission conflict.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limit exceeded.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Invocation service unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
