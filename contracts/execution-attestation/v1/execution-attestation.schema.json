{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/imprun/windforce-core/main/contracts/execution-attestation/v1/execution-attestation.schema.json",
  "title": "Windforce execution attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "binding",
    "bindingDigest",
    "algorithm",
    "signature"
  ],
  "properties": {
    "kind": {
      "const": "windforce.execution-attestation/v1"
    },
    "binding": {
      "$ref": "execution-attestation-binding.schema.json"
    },
    "bindingDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 128
    }
  }
}
