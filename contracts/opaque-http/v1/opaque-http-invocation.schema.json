{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/imprun/windforce-core/main/contracts/opaque-http/v1/opaque-http-invocation.schema.json",
  "title": "Windforce opaque HTTP invocation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "trustedIngress",
    "http",
    "body",
    "receivedAt",
    "deadlineAt"
  ],
  "properties": {
    "kind": {
      "const": "windforce.opaque-http-ingress-request/v1"
    },
    "trustedIngress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "audience",
        "publicationRef",
        "routeGeneration",
        "credentialRef",
        "deliveryId"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "publicationRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 100
        },
        "routeGeneration": {
          "type": "integer",
          "minimum": 1
        },
        "credentialRef": {
          "$ref": "#/$defs/immutableRef"
        },
        "deliveryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "http": {
      "$ref": "#/$defs/httpMedia"
    },
    "body": {
      "$ref": "#/$defs/bodyBytes"
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deadlineAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "immutableRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "httpMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "exactEscapedPath",
        "contentType"
      ],
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^[A-Z]+$",
          "maxLength": 32
        },
        "exactEscapedPath": {
          "type": "string",
          "pattern": "^/([A-Za-z0-9._~!$&'()+,;=:@/-]|%[0-9A-F]{2})*$",
          "allOf": [
            {
              "not": {
                "pattern": "//"
              }
            },
            {
              "not": {
                "pattern": "^/.+/$"
              }
            },
            {
              "not": {
                "pattern": "/(\\.|\\.\\.)(/|$)"
              }
            },
            {
              "not": {
                "pattern": "%2E|%2F|%5C|%25"
              }
            }
          ],
          "maxLength": 1024
        },
        "contentType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "bodyBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "data",
        "byteLength",
        "digest"
      ],
      "properties": {
        "encoding": {
          "const": "RFC4648-BASE64"
        },
        "data": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
