{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/imprun/windforce-core/main/contracts/webhooks/v1/control-plane-event.schema.json",
  "title": "Windforce Core webhook event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "type",
    "source",
    "subject",
    "time",
    "datacontenttype",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^evt_[A-Za-z0-9]+$"
    },
    "type": {
      "enum": [
        "windforce.release.published",
        "windforce.release.rolled_back",
        "windforce.webhook.test",
        "windforce.human_task.created",
        "windforce.human_task.decided",
        "windforce.human_task.expired",
        "windforce.human_task.canceled"
      ]
    },
    "source": {
      "type": "string",
      "pattern": "^/workspaces/[^/]+/(control-plane|execution)$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "data": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "windforce.release.rolled_back"
        },
        "source": {
          "pattern": "^/workspaces/[^/]+/control-plane$"
        },
        "subject": {
          "pattern": "^apps/[^/]+/releases/[^/]+$"
        },
        "data": {
          "$ref": "#/$defs/releaseRolledBackData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "windforce.release.published"
        },
        "source": {
          "pattern": "^/workspaces/[^/]+/control-plane$"
        },
        "subject": {
          "pattern": "^apps/[^/]+/releases/[^/]+$"
        },
        "data": {
          "$ref": "#/$defs/releasePublishedData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "windforce.webhook.test"
        },
        "source": {
          "pattern": "^/workspaces/[^/]+/control-plane$"
        },
        "subject": {
          "pattern": "^webhooks/[^/]+/test$"
        },
        "data": {
          "$ref": "#/$defs/webhookTestData"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "windforce.human_task.created"
        },
        "source": {
          "pattern": "^/workspaces/[^/]+/execution$"
        },
        "subject": {
          "pattern": "^human-tasks/[^/]+$"
        },
        "data": {
          "allOf": [
            { "$ref": "#/$defs/humanTaskLifecycleData" },
            {
              "properties": {
                "state": { "const": "pending" },
                "outcome": false,
                "terminal_cause": false
              }
            }
          ]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "windforce.human_task.decided"
        },
        "source": {
          "pattern": "^/workspaces/[^/]+/execution$"
        },
        "subject": {
          "pattern": "^human-tasks/[^/]+$"
        },
        "data": {
          "allOf": [
            { "$ref": "#/$defs/humanTaskLifecycleData" },
            {
              "required": ["outcome"],
              "properties": {
                "state": { "const": "decided" },
                "outcome": { "enum": ["submit", "cancel"] },
                "terminal_cause": false
              }
            }
          ]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "windforce.human_task.expired"
        },
        "source": {
          "pattern": "^/workspaces/[^/]+/execution$"
        },
        "subject": {
          "pattern": "^human-tasks/[^/]+$"
        },
        "data": {
          "allOf": [
            { "$ref": "#/$defs/humanTaskLifecycleData" },
            {
              "required": ["terminal_cause"],
              "properties": {
                "state": { "const": "expired" },
                "outcome": false
              }
            }
          ]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "windforce.human_task.canceled"
        },
        "source": {
          "pattern": "^/workspaces/[^/]+/execution$"
        },
        "subject": {
          "pattern": "^human-tasks/[^/]+$"
        },
        "data": {
          "allOf": [
            { "$ref": "#/$defs/humanTaskLifecycleData" },
            {
              "required": ["terminal_cause"],
              "properties": {
                "state": { "const": "canceled" },
                "outcome": false
              }
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "releasePublishedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "app_key",
        "release_id",
        "commit",
        "actor"
      ],
      "properties": {
        "workspace": {
          "type": "string",
          "minLength": 1
        },
        "app_key": {
          "type": "string",
          "minLength": 1
        },
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "previous_release_id": {
          "type": "string",
          "minLength": 1
        },
        "previous_commit": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "releaseRolledBackData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "app_key",
        "release_id",
        "commit",
        "previous_release_id",
        "previous_commit",
        "actor",
        "reason"
      ],
      "properties": {
        "workspace": {
          "type": "string",
          "minLength": 1
        },
        "app_key": {
          "type": "string",
          "minLength": 1
        },
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "previous_release_id": {
          "type": "string",
          "minLength": 1
        },
        "previous_commit": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "humanTaskLifecycleData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "task_id",
        "run_id",
        "job_id",
        "attempt",
        "app_key",
        "action_key",
        "mode",
        "kind",
        "state",
        "actor"
      ],
      "properties": {
        "workspace": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "job_id": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "app_key": { "type": "string", "minLength": 1 },
        "action_key": { "type": "string", "minLength": 1 },
        "correlation_id": { "type": "string", "minLength": 1 },
        "mode": { "const": "hold" },
        "kind": { "type": "string", "minLength": 1 },
        "state": { "enum": ["pending", "decided", "expired", "canceled"] },
        "outcome": { "enum": ["submit", "cancel"] },
        "actor": { "type": "string", "minLength": 1 },
        "terminal_cause": { "type": "string", "minLength": 1 }
      }
    },
    "webhookTestData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "subscription_id",
        "actor"
      ],
      "properties": {
        "workspace": {
          "type": "string",
          "minLength": 1
        },
        "subscription_id": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
